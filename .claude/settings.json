{
  "env": {
    "MCP_TOOL_TIMEOUT": "120000"
  },
  "enabledMcpjsonServers": [
    "playwright-test",
    "github"
  ],
  "permissions": {
    "allow": [
      "mcp__playwright-test",
      "Bash(npx playwright test:*)",
      "Bash(npx playwright show-report:*)",
      "Edit(apps/*/specs/**)",
      "Edit(apps/*/tests/**)",
      "Edit(apps/*/reports/**)"
    ]
  },
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/close-test-browsers.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/close-test-browsers.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
