{
  "env": {
    "MCP_TOOL_TIMEOUT": "120000"
  },
  "enabledMcpjsonServers": [
    "playwright-test",
    "github"
  ],
  "permissions": {
    "allow": [
      "mcp__playwright-test",
      "Bash(npx playwright test:*)",
      "Bash(npx playwright show-report:*)",
      "Write(specs/**)",
      "Edit(specs/**)",
      "Write(tests/**)",
      "Edit(tests/**)",
      "Write(reports/**)",
      "Edit(reports/**)"
    ]
  }
}
