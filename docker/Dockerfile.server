# FastAPI backend image. Built from the repo root so it can later shell out to
# scripts/ and read apps/ and prompts/ (mounted or copied in a later milestone).
FROM python:3.13-slim

# uv: fast, reproducible installs from pyproject + uv.lock.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Install deps first (layer cached until the lockfile changes).
COPY server/pyproject.toml server/uv.lock* ./
RUN uv sync --no-dev --no-install-project

# App code.
COPY server/app ./app

ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
