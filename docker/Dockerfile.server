# FastAPI backend image. Nothing is mounted into it: the prompts, the agent
# runtime and the delivery templates all ship inside the server package (they
# are under server/app/, which is copied below), and a target's configuration
# and tree come from Postgres and blob storage.
#
# It does not ship the `claude` CLI or node, and from P4 it does not have to:
# a run executes in its own container from docker/Dockerfile.sandbox, which
# carries the CLI, Node and the browsers. The two images are built from the same
# server package -- so the prompts, the agent runtime and the tracked-tree
# definition cannot disagree -- and versioned separately, so the thing serving
# HTTP stays small. The thread path (QA_SANDBOX=thread) still runs here, which is
# what keeps CI fast and token-free; with QA_RUNNER=claude it needs the sandbox
# image, which is the default the compose stack uses.
FROM python:3.13-slim

# git is a runtime dependency, not a build one: app/delivery clones, commits and
# pushes to customer repos from the control plane (it replaced scripts/*.sh,
# which ran on an operator's machine where git was simply assumed).
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# uv: fast, reproducible installs from pyproject + uv.lock.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Install deps first (layer cached until the lockfile changes).
COPY server/pyproject.toml server/uv.lock* ./
RUN uv sync --no-dev --no-install-project

# App code + migrations.
COPY server/app ./app
COPY server/alembic ./alembic
COPY server/alembic.ini ./alembic.ini
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENV PATH="/app/.venv/bin:$PATH"
EXPOSE 8000

# Entrypoint runs `alembic upgrade head` then uvicorn.
CMD ["/entrypoint.sh"]
