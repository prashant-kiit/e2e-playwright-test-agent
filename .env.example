# Copy to .env for local runs (.env is git-ignored), then source it yourself:
# `set -a; . ./.env; set +a`. Nothing loads this file automatically -- the
# delivery tools read the process environment only (README.md 6.5). In
# CI/sandbox, inject these as platform secrets instead.

# Fine-grained GitHub PAT for the target repos: push, pull-request and workflow
# rights. Used by server/app/delivery/ and by nothing else.
GITHUB_PAT=

# The model the agent talks to. Needed only for QA_RUNNER=claude: the compose
# stack passes it to the API, which puts it in each sandbox's environment and
# nowhere else (server/app/sandbox/env.py). Unset, the default fake runner runs
# token-free.
ANTHROPIC_API_KEY=

# Where a run executes (P4). `docker` is the compose stack's default -- a
# container per run, on an internal network with no route out except an
# allowlisting proxy. `thread` is today's in-process path and the default for
# tests, CI and a bare `uvicorn`.
# QA_SANDBOX=docker

# The limits around a run, each with a sane default. A breach ends the run
# `failed` with the reason in its log and on the row, the app lock freed and the
# last committed revision intact.
# QA_STEP_TIMEOUT_S=1800      # 30 minutes for one step
# QA_RUN_TIMEOUT_S=7200       # two hours for the whole run
# QA_SPEND_BUDGET_USD=20      # per run, from the agent runtime's own cost reports
# QA_LOG_RETENTION_DAYS=7     # how long the live log's rows are kept; session.jsonl is the archive
