# Copy to .env for local runs (.env is git-ignored), then source it yourself:
# `set -a; . ./.env; set +a`. Nothing loads this file automatically -- the
# delivery tools read the process environment only (README.md 6.5). In
# CI/sandbox, inject these as platform secrets instead.

# There is no GITHUB_PAT here any more (P5-03). A GitHub credential is per
# tenant now: each target carries its own, saved in the portal (Credential
# panel), validated against GitHub for `repo` + `workflow` scope the moment it
# is pasted, and stored as ciphertext whose data key is wrapped by a KMS key.
# One operator token in the environment meant every delivery into every
# customer's repository was authored by the same identity, so the variable was
# retired rather than kept as a fallback.

# Whether this process is a deployment or a development stack. **It defaults
# to `prod`**, and that direction is the point: unset, the session cookies are
# `Secure` and a missing envelope key below refuses to boot. `QA_ENV=dev` is
# the opt-out, and the only thing it buys is plain-HTTP cookies and a
# well-known envelope key -- the compose stack sets it, and a bare `uvicorn`
# served over http needs it too.
# QA_ENV=dev

# The cloud KMS key that wraps those data keys. **This is the production
# answer**: the wrapping key never leaves the KMS and a PAT never reaches it.
# Unset, the portal builds an in-process wrapping key from QA_ENVELOPE_KEY
# instead: real AES-GCM, fine for development, and *not* a production
# configuration -- the key then sits in the same process as the ciphertext it
# protects, which is what a KMS exists to prevent (server/app/envelope.py).
# QA_KMS_KEY_ID=arn:aws:kms:eu-west-1:123456789012:key/...

# The key that in-process wrapping derives from, where QA_KMS_KEY_ID is unset.
# **It is not QA_SECRET_KEY, and must not be set to the same value** -- the
# portal refuses to start if it is. They are two unrelated jobs: one signs
# session cookies, the other decrypts every stored customer PAT, and while they
# were one variable, rotating the cookie key destroyed every stored credential
# and a leak of it read them all. A deployment with neither this nor
# QA_KMS_KEY_ID does not start; `QA_ENV=dev` falls back to a key published in
# server/app/envelope.py, which is why that fallback is a development-only one.
# Supply it the way you supply QA_SECRET_KEY: a platform secret, never a file
# in this repository.
# QA_ENVELOPE_KEY=

# The model the agent talks to. Needed only for QA_RUNNER=claude: the compose
# stack passes it to the API, which puts it in each sandbox's environment and
# nowhere else (server/app/sandbox/env.py). Unset, the default fake runner runs
# token-free.
ANTHROPIC_API_KEY=

# Where a run executes (P4). `docker` is the compose stack's default -- a
# container per run, on an internal network with no route out except an
# allowlisting proxy. `thread` is today's in-process path and the default for
# tests, CI and a bare `uvicorn`.
# QA_SANDBOX=docker

# Signs the portal's session cookies and, since P5-05, the run-scoped tokens a
# sandbox presents to the internal control-plane API. **Set this in any
# deployment**: unset, the API falls back to a well-known development default,
# and anything holding this key can mint a token for any run of any tenant. It
# never reaches a sandbox -- that is asserted structurally
# (server/tests/test_sandbox_credentials.py). `QA_RUN_TOKEN_KEY` signs the run
# tokens instead, if you want the two separated. It no longer protects stored
# PATs -- that is `QA_ENVELOPE_KEY` above.
# QA_SECRET_KEY=
# QA_RUN_TOKEN_KEY=

# Where a sandbox reaches the internal control-plane API (P5-05). The API's own
# name on the sandbox network, not the portal's public origin: it is the one
# address a run can resolve. The compose default is right for the dev stack;
# override it where the API is somewhere else.
# QA_CONTROL_PLANE_URL=http://api:8000

# There is no DATABASE_URL or S3_* for a sandbox any more (P5-05). A run used to
# be handed the control plane's own store credentials -- read and write access to
# every tenant's rows and blobs -- and trusted not to misuse them. It now holds a
# token scoped to one run of one target of one tenant, which stops working the
# moment that run is no longer live, and the stores are not on its network at
# all. The API still needs them, and compose supplies them.

# The limits around a run, each with a sane default. A breach ends the run
# `failed` with the reason in its log and on the row, the app lock freed and the
# last committed revision intact.
# QA_STEP_TIMEOUT_S=1800      # 30 minutes for one step
# QA_RUN_TIMEOUT_S=7200       # two hours for the whole run
# QA_SPEND_BUDGET_USD=20      # per run, from the agent runtime's own cost reports
# QA_LOG_RETENTION_DAYS=7     # how long the live log's rows are kept; session.jsonl is the archive
